{
  "name": "investment-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal investment intelligence & portfolio management dashboard (India)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backup": "tsx server/scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
