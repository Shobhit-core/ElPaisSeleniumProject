# Copy to .env (never commit .env). All secrets stay on the server; nothing here reaches the browser.

# --- Dashboard sign-in (required) ---
# Preferred: a scrypt hash. Generate with:  npx tsx server/scripts/backup.ts hash-password "your long passphrase"
APP_PASSWORD_HASH=
# Alternative for local use only (hashed in memory at startup):
# APP_PASSWORD=

# --- Server ---
HOST=127.0.0.1
PORT=8787
# Set to true when served over HTTPS (required if HOST is not loopback)
COOKIE_SECURE=false
# DB_PATH=./data/portfolio.db
# BACKUP_DIR=./backups
# LOG_LEVEL=info

# --- Upstox (optional, read-only account data) ---
# Create an app at https://account.upstox.com/developer/apps ; set its redirect URL to
#   http://127.0.0.1:8787/api/broker/callback   (or your HTTPS origin + /api/broker/callback)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8787/api/broker/callback
# 64 hex chars; encrypts the broker access token at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- AI research mode (optional, paid Anthropic API usage) ---
# ANTHROPIC_API_KEY=
# ANALYST_MODEL=claude-opus-5-5

# Behind a corporate/HTTPS proxy, Node's fetch needs this to honour HTTPS_PROXY:
# NODE_USE_ENV_PROXY=1
